{
  "name": "vscode-local-notifier",
  "displayName": "Local Notifier for VS Code",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "shou6",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#162E68",
    "theme": "dark"
  },
  "homepage": "https://github.com/shou6/vscode-local-notifier#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shou6/vscode-local-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/shou6/vscode-local-notifier/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "notification",
    "notifications",
    "desktop notification",
    "toast",
    "alert",
    "hook",
    "hooks",
    "ai",
    "ai agent",
    "coding agent",
    "claude",
    "claude code",
    "devcontainer",
    "dev container",
    "wsl",
    "remote",
    "windows"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist/extension.js",
    "resources/**",
    "l10n/**",
    "package.nls.json",
    "package.nls.ja.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localNotifier.sendTestNotification",
        "title": "%command.sendTestNotification%",
        "category": "Local Notifier"
      },
      {
        "command": "localNotifier.copyHookCommand",
        "title": "%command.copyHookCommand%",
        "category": "Local Notifier"
      },
      {
        "command": "localNotifier.showStatus",
        "title": "%command.showStatus%",
        "category": "Local Notifier"
      }
    ],
    "configuration": {
      "title": "Local Notifier",
      "properties": {
        "localNotifier.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "localNotifier.inboxPath": {
          "type": "string",
          "default": "",
          "description": "%config.inboxPath%"
        },
        "localNotifier.presets": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.presets%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "%config.presets.title%"
              },
              "message": {
                "type": "string",
                "description": "%config.presets.message%"
              },
              "level": {
                "type": "string",
                "enum": [
                  "info",
                  "success",
                  "warning",
                  "error"
                ],
                "description": "%config.presets.level%"
              },
              "source": {
                "type": "string",
                "description": "%config.presets.source%"
              }
            },
            "additionalProperties": false
          }
        },
        "localNotifier.showLevelIcon": {
          "type": "boolean",
          "default": true,
          "description": "%config.showLevelIcon%"
        },
        "localNotifier.duration": {
          "type": "object",
          "markdownDescription": "%config.duration%",
          "default": {
            "info": "short",
            "success": "short",
            "warning": "long",
            "error": "long"
          },
          "properties": {
            "info": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "enumDescriptions": [
                "%config.duration.short%",
                "%config.duration.long%"
              ]
            },
            "success": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "enumDescriptions": [
                "%config.duration.short%",
                "%config.duration.long%"
              ]
            },
            "warning": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "enumDescriptions": [
                "%config.duration.short%",
                "%config.duration.long%"
              ]
            },
            "error": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "enumDescriptions": [
                "%config.duration.short%",
                "%config.duration.long%"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && mocha",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "test": "vscode-test",
    "vsix": "vsce package",
    "try": "node scripts/try-extension.js",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration:local": "node scripts/test-integration-local.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "verify:package": "npm run compile-tests && node scripts/verify-package.js",
    "icon": "node scripts/generate-icon.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
